rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isJobHunter() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/jobHunters/$(request.auth.uid));
    }

    function isAgency() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/agencies/$(request.auth.uid));
    }

    function isVerifiedAgency() {
      return isAgency() &&
             get(/databases/$(database)/documents/agencies/$(request.auth.uid)).data.verified == true;
    }

    function isAdmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function getAdmin() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function hasPermission(permission) {
      return isAdmin() &&
             (getAdmin().role == 'super_admin' ||
              permission in getAdmin().permissions);
    }

    // Subscription helper functions
    function getAgencySubscription(agencyId) {
      return get(/databases/$(database)/documents/subscriptions/$(agencyId)).data;
    }

    function hasActiveSubscription(agencyId) {
      return exists(/databases/$(database)/documents/subscriptions/$(agencyId)) &&
             getAgencySubscription(agencyId).status == 'active' &&
             getAgencySubscription(agencyId).endDate.toMillis() > request.time.toMillis();
    }

    function isPremiumAgency(agencyId) {
      return hasActiveSubscription(agencyId) &&
             getAgencySubscription(agencyId).plan == 'premium';
    }

    function canPostJob(agencyId) {
      // If no subscription exists, allow posting (free tier will be created on first post)
      return !exists(/databases/$(database)/documents/subscriptions/$(agencyId)) ||
             // If subscription exists and is free tier, check if under limit
             (exists(/databases/$(database)/documents/subscriptions/$(agencyId)) &&
              getAgencySubscription(agencyId).plan == 'free' &&
              getAgencySubscription(agencyId).lifetimeJobsPosted < 2) ||
             // If subscription exists and is premium, allow posting
             isPremiumAgency(agencyId);
    }

    // Validate data size limits
    function validateStringLength(field, minLen, maxLen) {
      return field is string && field.size() >= minLen && field.size() <= maxLen;
    }

    function validateEmail(email) {
      return email is string && email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }

    // Users collection - basic user info
    match /users/{userId} {
      // Only allow users to read their own profile or admins to read any
      allow read: if isOwner(userId) || isAdmin();

      // UPDATED: Require legal acceptance fields on user creation
      allow create: if isOwner(userId) &&
                      request.resource.data.keys().hasAll([
                        'email', 'userType',
                        'termsAcceptedAt', 'termsVersion',
                        'privacyAcceptedAt', 'privacyVersion'
                      ]) &&
                      validateEmail(request.resource.data.email) &&
                      request.resource.data.userType in ['jobhunter', 'agency', 'admin'] &&
                      request.resource.data.termsAcceptedAt is timestamp &&
                      request.resource.data.termsVersion is string &&
                      request.resource.data.privacyAcceptedAt is timestamp &&
                      request.resource.data.privacyVersion is string &&
                      // For jobhunters, require age verification
                      (request.resource.data.userType != 'jobhunter' ||
                       (request.resource.data.keys().hasAll(['dateOfBirth', 'ageVerified']) &&
                        request.resource.data.dateOfBirth is timestamp &&
                        request.resource.data.ageVerified == true));

      // UPDATED: Prevent modification of legal acceptance fields
      allow update: if isOwner(userId) &&
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                        'email', 'userType', 'createdAt',
                        'termsAcceptedAt', 'termsVersion',
                        'privacyAcceptedAt', 'privacyVersion',
                        'dateOfBirth', 'ageVerified'
                      ]);
      allow delete: if isOwner(userId);
    }

    // Admins collection
    match /admins/{userId} {
      // Allow any authenticated user to read admin profiles
      // This is needed for displaying admin info in conversations
      allow get: if isAuthenticated();
      // Only admins can list/query all admin profiles
      allow list: if isAdmin();
      allow create: if isOwner(userId); // Allow users to create their own admin profile
      allow update: if isOwner(userId) || hasPermission('MANAGE_PERMISSIONS');
      allow delete: if hasPermission('MANAGE_PERMISSIONS');
    }

    // Job Hunters collection - extended profile
    match /jobHunters/{userId} {
      // Allow users to read their own profile, agencies and admins to read any
      allow read: if isOwner(userId) || isAgency() || isAdmin();
      allow create: if isOwner(userId) &&
                      request.resource.data.keys().hasAll(['email', 'userType']) &&
                      validateEmail(request.resource.data.email) &&
                      request.resource.data.userType == 'jobhunter' &&
                      request.resource.data.skills is list &&
                      request.resource.data.skills.size() <= 50;
      // UPDATED: Prevent modification of legal fields by users
      allow update: if (isOwner(userId) &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                          'termsAcceptedAt', 'termsVersion',
                          'privacyAcceptedAt', 'privacyVersion',
                          'dateOfBirth', 'ageVerified'
                        ])) ||
                       isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Agencies collection - company info
    match /agencies/{userId} {
      // Allow public read access so anyone can view agency profiles
      allow read: if true;

      // UPDATED: Require agency terms acceptance on creation
      allow create: if isOwner(userId) &&
                      request.resource.data.keys().hasAll([
                        'email', 'userType',
                        'termsAcceptedAt', 'termsVersion',
                        'privacyAcceptedAt', 'privacyVersion',
                        'agencyTermsAcceptedAt', 'agencyTermsVersion'
                      ]) &&
                      validateEmail(request.resource.data.email) &&
                      request.resource.data.userType == 'agency' &&
                      request.resource.data.termsAcceptedAt is timestamp &&
                      request.resource.data.termsVersion is string &&
                      request.resource.data.privacyAcceptedAt is timestamp &&
                      request.resource.data.privacyVersion is string &&
                      request.resource.data.agencyTermsAcceptedAt is timestamp &&
                      request.resource.data.agencyTermsVersion is string &&
                      (!request.resource.data.keys().hasAny(['agencyTermsAcceptedIP']) ||
                       request.resource.data.agencyTermsAcceptedIP is string) &&
                      (!request.resource.data.keys().hasAny(['verified']) ||
                       request.resource.data.verified == false);

      // UPDATED: Prevent modification of legal fields (except by admins)
      // Also validate certification file arrays (max 5 files per type)
      allow update: if (isOwner(userId) &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                          'verified',
                          'termsAcceptedAt', 'termsVersion',
                          'privacyAcceptedAt', 'privacyVersion',
                          'agencyTermsAcceptedAt', 'agencyTermsVersion',
                          'agencyTermsAcceptedIP'
                        ]) &&
                        // Validate max 5 files per certification type
                        (!request.resource.data.keys().hasAny(['dmwLicenseFiles']) ||
                         (request.resource.data.dmwLicenseFiles is list &&
                          request.resource.data.dmwLicenseFiles.size() <= 5)) &&
                        (!request.resource.data.keys().hasAny(['businessPermitFiles']) ||
                         (request.resource.data.businessPermitFiles is list &&
                          request.resource.data.businessPermitFiles.size() <= 5))) ||
                       isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Jobs collection - SECURE RULES
    match /jobs/{jobId} {
      // Public read access for browsing jobs
      allow read: if true;

      // Only agencies can create jobs - with proper security
      allow create: if isAgency() &&
                      // Critical security checks
                      request.resource.data.agencyId == request.auth.uid &&
                      // Subscription check - enforce job posting limits
                      canPostJob(request.auth.uid) &&
                      // Agency profile must be complete with certifications
                      // Support both new multi-file fields (dmwLicenseFiles) and legacy single URL (dmwLicenseUrl)
                      (
                        // Check new multi-file fields (array with at least 1 file)
                        (get(/databases/$(database)/documents/agencies/$(request.auth.uid)).data.keys().hasAny(['dmwLicenseFiles']) &&
                         get(/databases/$(database)/documents/agencies/$(request.auth.uid)).data.dmwLicenseFiles is list &&
                         get(/databases/$(database)/documents/agencies/$(request.auth.uid)).data.dmwLicenseFiles.size() > 0) ||
                        // Fallback to legacy single URL field
                        get(/databases/$(database)/documents/agencies/$(request.auth.uid)).data.dmwLicenseUrl != null
                      ) &&
                      (
                        // Check new multi-file fields
                        (get(/databases/$(database)/documents/agencies/$(request.auth.uid)).data.keys().hasAny(['businessPermitFiles']) &&
                         get(/databases/$(database)/documents/agencies/$(request.auth.uid)).data.businessPermitFiles is list &&
                         get(/databases/$(database)/documents/agencies/$(request.auth.uid)).data.businessPermitFiles.size() > 0) ||
                        // Fallback to legacy single URL field
                        get(/databases/$(database)/documents/agencies/$(request.auth.uid)).data.businessPermitUrl != null
                      ) &&
                      get(/databases/$(database)/documents/agencies/$(request.auth.uid)).data.logoUrl != null &&
                      get(/databases/$(database)/documents/agencies/$(request.auth.uid)).data.registrationNumber != null &&
                      get(/databases/$(database)/documents/agencies/$(request.auth.uid)).data.phone != null &&
                      // Field validations (adjusted for realistic use)
                      validateStringLength(request.resource.data.title, 5, 200) &&
                      validateStringLength(request.resource.data.description, 10, 10000) &&
                      request.resource.data.skills is list &&
                      request.resource.data.skills.size() <= 50 &&
                      request.resource.data.experienceRequired >= 0 &&
                      request.resource.data.experienceRequired <= 50;

      // Job owner or admin can update
      allow update: if (isAgency() &&
                        resource.data.agencyId == request.auth.uid &&
                        // Cannot change owner
                        request.resource.data.agencyId == resource.data.agencyId) ||
                       isAdmin();

      // Job owner or admin can delete
      allow delete: if (isAgency() &&
                        resource.data.agencyId == request.auth.uid) ||
                       isAdmin();
    }

    // Applications collection
    match /applications/{applicationId} {
      // Job hunters can read their own applications
      // Agencies can read applications for their jobs
      allow get: if isAuthenticated() && (
                    resource.data.jobHunterId == request.auth.uid ||
                    resource.data.agencyId == request.auth.uid
                  );

      // Allow list queries - Firestore will filter based on the query constraints
      // This enables queries like where('jobHunterId', '==', userId)
      allow list: if isAuthenticated();

      // Only job hunters can create applications
      allow create: if isJobHunter() &&
                      request.resource.data.keys().hasAll([
                        'jobId', 'jobHunterId', 'agencyId',
                        'status', 'appliedAt'
                      ]) &&
                      request.resource.data.jobHunterId == request.auth.uid &&
                      request.resource.data.status == 'pending' &&
                      request.resource.data.appliedAt is timestamp &&
                      // Validate job exists
                      exists(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)) &&
                      // Validate optional fields
                      (!request.resource.data.keys().hasAny(['coverLetter']) ||
                       request.resource.data.coverLetter == null ||
                       validateStringLength(request.resource.data.coverLetter, 0, 5000)) &&
                      (!request.resource.data.keys().hasAny(['resumeUrl']) ||
                       request.resource.data.resumeUrl == null ||
                       request.resource.data.resumeUrl is string) &&
                      (!request.resource.data.keys().hasAny(['conversationId']) ||
                       request.resource.data.conversationId == null ||
                       request.resource.data.conversationId is string);

      // Job hunters can update their own applications (withdraw, update cover letter)
      // Agencies can update status only
      allow update: if isAuthenticated() && (
                      (resource.data.jobHunterId == request.auth.uid &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'jobId', 'jobHunterId', 'agencyId'])) ||
                      (get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.agencyId == request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                       request.resource.data.status in ['pending', 'reviewing', 'shortlisted', 'rejected', 'hired'])
                    );

      // Only job hunters can delete their own applications (before review)
      allow delete: if isJobHunter() &&
                      resource.data.jobHunterId == request.auth.uid &&
                      resource.data.status == 'pending';
    }

    // Conversations collection
    match /conversations/{conversationId} {
      // Participants can read their own conversations
      // Also allow read if conversation doesn't exist (for checking before creation)
      allow get: if isAuthenticated() && (
                    !exists(/databases/$(database)/documents/conversations/$(conversationId)) ||
                    resource.data.jobHunterId == request.auth.uid ||
                    resource.data.agencyId == request.auth.uid
                  );

      // Allow list queries for authenticated users
      // Firestore will only return documents matching the where() clause
      allow list: if isAuthenticated();

      // Both parties can create conversations
      // Permissive to allow dynamic field names like unreadCount_${userId}
      allow create: if isAuthenticated() &&
                      // Required fields must exist and have correct types
                      request.resource.data.keys().hasAll(['jobId', 'jobHunterId', 'agencyId', 'createdAt', 'updatedAt']) &&
                      request.resource.data.jobId is string &&
                      request.resource.data.jobHunterId is string &&
                      request.resource.data.agencyId is string &&
                      request.resource.data.createdAt is timestamp &&
                      request.resource.data.updatedAt is timestamp &&
                      // User must be a participant
                      (request.resource.data.jobHunterId == request.auth.uid ||
                       request.resource.data.agencyId == request.auth.uid);
                      // Validate job exists - temporarily disabled to debug
                      // exists(/databases/$(database)/documents/jobs/$(request.resource.data.jobId));

      // Participants can update lastMessage, unreadCount fields, typing indicators, and updatedAt
      // Don't allow changing core identifiers (jobId, jobHunterId, agencyId, createdAt)
      allow update: if isAuthenticated() && (
                      resource.data.jobHunterId == request.auth.uid ||
                      resource.data.agencyId == request.auth.uid
                    ) &&
                    !request.resource.data.diff(resource.data).affectedKeys()
                      .hasAny(['jobId', 'jobHunterId', 'agencyId', 'createdAt']);

      // No deletion of conversations
      allow delete: if false;

      // Messages subcollection
      match /messages/{messageId} {
        // Participants can read messages
        allow read: if isAuthenticated() && (
                      get(/databases/$(database)/documents/conversations/$(conversationId)).data.jobHunterId == request.auth.uid ||
                      get(/databases/$(database)/documents/conversations/$(conversationId)).data.agencyId == request.auth.uid
                    );

        // Participants can create messages with rate limiting
        allow create: if isAuthenticated() &&
                        request.resource.data.keys().hasAll([
                          'senderId', 'senderType', 'conversationId', 'content', 'timestamp', 'read'
                        ]) &&
                        request.resource.data.senderId == request.auth.uid &&
                        request.resource.data.conversationId == conversationId &&
                        request.resource.data.senderType in ['jobhunter', 'agency'] &&
                        validateStringLength(request.resource.data.content, 1, 2000) &&
                        request.resource.data.timestamp is timestamp &&
                        request.resource.data.read is bool &&
                        (get(/databases/$(database)/documents/conversations/$(conversationId)).data.jobHunterId == request.auth.uid ||
                         get(/databases/$(database)/documents/conversations/$(conversationId)).data.agencyId == request.auth.uid);

        // Only sender can update their messages (mark as edited) or receiver can mark as read
        allow update: if isAuthenticated() && (
                        (resource.data.senderId == request.auth.uid &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'edited', 'editedAt'])) ||
                        (resource.data.senderId != request.auth.uid &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']))
                      );

        // No deletion of messages
        allow delete: if false;
      }
    }

    // Saved Jobs collection (user-specific)
    match /savedJobs/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);

      match /jobs/{jobId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
                        isJobHunter() &&
                        exists(/databases/$(database)/documents/jobs/$(jobId));
        allow delete: if isOwner(userId);
      }
    }

    // Featured Requests collection
    match /featuredRequests/{requestId} {
      // Admins can read all requests
      // Agencies can read their own requests
      allow read: if isAuthenticated();

      // Only verified agencies with premium subscription can create featured requests
      allow create: if isVerifiedAgency() &&
                      // Must have active premium subscription for featured jobs
                      isPremiumAgency(request.auth.uid) &&
                      request.resource.data.keys().hasAll([
                        'jobId', 'agencyId', 'status',
                        'paymentMethod', 'paymentReference',
                        'paymentAmount', 'currency', 'createdAt', 'updatedAt'
                      ]) &&
                      request.resource.data.agencyId == request.auth.uid &&
                      request.resource.data.status == 'pending' &&
                      request.resource.data.paymentAmount > 0 &&
                      request.resource.data.paymentMethod in ['gcash', 'paymaya', 'bank_transfer', 'paypal'] &&
                      validateStringLength(request.resource.data.paymentReference, 1, 100) &&
                      // Validate job exists and belongs to agency
                      exists(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)) &&
                      get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.agencyId == request.auth.uid;

      // Agencies can update their own pending requests
      // Admins can update any request (approve/reject)
      allow update: if isAuthenticated();

      // No deletion of featured requests
      allow delete: if false;
    }

    // Job Views collection (for analytics)
    match /jobViews/{viewId} {
      // Anyone can read view counts (aggregated)
      allow read: if true;

      // Anyone can create a view (track anonymous and authenticated views)
      allow create: if request.resource.data.keys().hasAll(['jobId', 'viewedAt']) &&
                      request.resource.data.viewedAt is timestamp &&
                      exists(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)) &&
                      // If userId field exists, it must match authenticated user
                      (!request.resource.data.keys().hasAny(['userId']) ||
                       request.resource.data.userId == null ||
                       (isAuthenticated() && request.resource.data.userId == request.auth.uid));

      // No updates or deletes
      allow update, delete: if false;
    }

    // Agency Stats collection (cached aggregations)
    match /agencyStats/{agencyId} {
      // Anyone can read stats
      allow read: if true;

      // Only the agency or system can write
      allow write: if isOwner(agencyId) || isAgency();
    }

    // Agency Reviews collection (future)
    match /agencyReviews/{reviewId} {
      // Anyone can read reviews
      allow read: if true;

      // Only job hunters who were hired can create reviews
      allow create: if isJobHunter() &&
                      request.resource.data.keys().hasAll(['agencyId', 'jobHunterId', 'rating', 'createdAt']) &&
                      request.resource.data.jobHunterId == request.auth.uid &&
                      request.resource.data.rating >= 1 &&
                      request.resource.data.rating <= 5 &&
                      request.resource.data.createdAt is timestamp;

      // Only owner can update their review
      allow update: if isAuthenticated() &&
                      resource.data.jobHunterId == request.auth.uid;

      // No deletes
      allow delete: if false;
    }

    // Notifications collection
    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if isAuthenticated() &&
                     resource.data.userId == request.auth.uid;

      // Admins can create notifications for users when sending messages
      // System/backend can also create notifications via Cloud Functions
      allow create: if isAdmin() ||
                      // Server-side operations (Cloud Functions)
                      request.auth == null;

      // Users can update their own notifications (mark as read)
      allow update: if isAuthenticated() &&
                      resource.data.userId == request.auth.uid &&
                      request.resource.data.userId == resource.data.userId &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'updatedAt']);

      // Users can delete their own notifications
      allow delete: if isAuthenticated() &&
                      resource.data.userId == request.auth.uid;
    }

    // Notification Preferences collection
    match /notificationPreferences/{userId} {
      // Users can read their own preferences
      allow read: if isAuthenticated() && userId == request.auth.uid;

      // Users can create their own preferences
      allow create: if isAuthenticated() &&
                      userId == request.auth.uid &&
                      request.resource.data.keys().hasAll(['emailNotifications']) &&
                      request.resource.data.emailNotifications is bool;

      // Users can update their own preferences
      allow update: if isAuthenticated() && userId == request.auth.uid;

      // Users can delete their own preferences
      allow delete: if isAuthenticated() && userId == request.auth.uid;
    }

    // Audit Logs collection
    match /auditLogs/{logId} {
      // Only admins with VIEW_AUDIT_LOGS permission or super_admins can read
      allow read: if hasPermission('VIEW_AUDIT_LOGS') ||
                     (isAdmin() && getAdmin().role == 'super_admin');

      // Only admins can create audit logs
      allow create: if isAdmin() &&
                      request.resource.data.keys().hasAll([
                        'adminId', 'adminName', 'action',
                        'resourceType', 'resourceId', 'timestamp'
                      ]) &&
                      request.resource.data.adminId == request.auth.uid &&
                      request.resource.data.timestamp is timestamp;

      // Audit logs are immutable - no updates or deletes allowed
      allow update, delete: if false;
    }

    // Platform Settings collection
    match /settings/{settingId} {
      // Only admins can read settings
      allow read: if isAdmin();

      // Only super admins can write settings, or admins with MANAGE_SETTINGS permission
      allow write: if isAdmin() &&
                   (getAdmin().role == 'super_admin' ||
                    'MANAGE_SETTINGS' in getAdmin().permissions);
    }

    // Contacts collection (Contact form submissions)
    match /contacts/{contactId} {
      // Authenticated users (admins/agencies) can read contacts
      allow read: if isAuthenticated();

      // Only server-side (Admin SDK) can write to contacts
      // Client-side writes are blocked - submissions go through API route
      allow write: if false;
    }

    // Admin Messages collection (Bulk messages from admins to users)
    match /adminMessages/{messageId} {
      // Admins can get their own messages, users can get messages sent to them
      allow get: if isAuthenticated() &&
                    ((isAdmin() && (resource.data.adminId == request.auth.uid ||
                                    hasPermission('SEND_MESSAGES') ||
                                    hasPermission('SEND_BULK_MESSAGES'))) ||
                     (request.auth.uid in resource.data.recipientIds));

      // Both admins and users can list/query their messages
      allow list: if isAuthenticated();

      // Only admins with messaging permissions can create messages
      allow create: if isAdmin() &&
                      (hasPermission('SEND_MESSAGES') ||
                       hasPermission('SEND_BULK_MESSAGES')) &&
                      request.resource.data.adminId == request.auth.uid;

      // Only the admin who created the message can update it
      allow update: if isAdmin() &&
                      resource.data.adminId == request.auth.uid &&
                      request.resource.data.adminId == request.auth.uid;

      // Only the admin who created the message can delete it
      allow delete: if isAdmin() &&
                      resource.data.adminId == request.auth.uid;
    }

    // Admin Conversations collection (Individual conversations between admins and users)
    match /adminConversations/{conversationId} {
      // Allow authenticated users to read - we verify ownership in the application layer
      // This is safe because users can only see conversations they create through the contact form
      allow read: if isAuthenticated();

      // Admins with messaging permissions can create conversations
      allow create: if isAdmin() &&
                      hasPermission('SEND_MESSAGES') &&
                      request.resource.data.adminId == request.auth.uid;

      // Both admin and user can update conversation (for read status)
      allow update: if isAuthenticated() &&
                      (resource.data.adminId == request.auth.uid ||
                       resource.data.userId == request.auth.uid);

      // Only the admin can delete the conversation
      allow delete: if isAdmin() &&
                      resource.data.adminId == request.auth.uid;

      // Messages subcollection
      match /messages/{messageId} {
        // Allow authenticated users to read messages - ownership verified at parent conversation level
        allow read: if isAuthenticated();

        // Both admin and user can create messages in their conversations
        allow create: if isAuthenticated() &&
                        (get(/databases/$(database)/documents/adminConversations/$(conversationId)).data.adminId == request.auth.uid ||
                         get(/databases/$(database)/documents/adminConversations/$(conversationId)).data.userId == request.auth.uid) &&
                        request.resource.data.senderId == request.auth.uid &&
                        validateStringLength(request.resource.data.content, 1, 2000);

        // Messages can be updated to mark as read
        allow update: if isAuthenticated() &&
                        (get(/databases/$(database)/documents/adminConversations/$(conversationId)).data.adminId == request.auth.uid ||
                         get(/databases/$(database)/documents/adminConversations/$(conversationId)).data.userId == request.auth.uid) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);

        // Messages cannot be deleted
        allow delete: if false;
      }
    }

    // Subscriptions collection
    match /subscriptions/{subscriptionId} {
      // Agencies can read their own subscription, admins can read all
      allow read: if isAuthenticated() &&
                     (subscriptionId == request.auth.uid || isAdmin());

      // Only admins can create/update subscriptions
      allow create, update: if isAdmin() &&
                              request.resource.data.keys().hasAll([
                                'agencyId', 'plan', 'status'
                              ]) &&
                              request.resource.data.plan in ['free', 'premium'] &&
                              request.resource.data.status in ['active', 'expired', 'cancelled', 'suspended'];

      // Only admins can delete subscriptions
      allow delete: if isAdmin();
    }

    // Subscription Payments collection
    match /subscriptionPayments/{paymentId} {
      // Agencies can read their own payments, admins can read all
      allow read: if isAuthenticated() &&
                     (resource.data.agencyId == request.auth.uid || isAdmin());

      // Agencies can create payment submissions, admins can update/process them
      allow create: if isAgency() &&
                       request.resource.data.agencyId == request.auth.uid &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.keys().hasAll([
                         'subscriptionId', 'agencyId', 'amount', 'currency',
                         'paymentMethod', 'paymentReference', 'status',
                         'periodStart', 'periodEnd', 'createdAt', 'updatedAt'
                       ]);

      allow update: if isAdmin();

      // Never delete payment records
      allow delete: if false;
    }

    // Job Posting Limits configuration
    match /jobPostingLimits/{configId} {
      // Anyone can read the limits
      allow read: if true;

      // Only super admins can update limits
      allow write: if isAdmin() && getAdmin().role == 'super_admin';
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
