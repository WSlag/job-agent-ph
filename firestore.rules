rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isJobHunter() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/jobHunters/$(request.auth.uid));
    }

    function isAgency() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/agencies/$(request.auth.uid));
    }

    function isVerifiedAgency() {
      return isAgency() &&
             get(/databases/$(database)/documents/agencies/$(request.auth.uid)).data.verified == true;
    }

    // Validate data size limits
    function validateStringLength(field, minLen, maxLen) {
      return field is string && field.size() >= minLen && field.size() <= maxLen;
    }

    function validateEmail(email) {
      return email is string && email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }

    // Users collection - basic user info
    match /users/{userId} {
      // Temporarily allow all authenticated reads to debug
      allow read: if request.auth != null;
      allow create: if isOwner(userId) &&
                      request.resource.data.keys().hasAll(['email', 'userType']) &&
                      validateEmail(request.resource.data.email) &&
                      request.resource.data.userType in ['jobhunter', 'agency', 'admin'];
      allow update: if isOwner(userId) &&
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['email', 'userType', 'createdAt']);
      allow delete: if isOwner(userId);
    }

    // Admins collection
    match /admins/{userId} {
      // Temporarily allow all authenticated reads to debug
      allow read: if request.auth != null;
      allow create: if isOwner(userId); // Allow users to create their own admin profile
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // Job Hunters collection - extended profile
    match /jobHunters/{userId} {
      // Temporarily allow all authenticated reads to debug
      allow read: if request.auth != null;
      allow create: if isOwner(userId) &&
                      request.resource.data.keys().hasAll(['email', 'userType']) &&
                      validateEmail(request.resource.data.email) &&
                      request.resource.data.userType == 'jobhunter' &&
                      request.resource.data.skills is list &&
                      request.resource.data.skills.size() <= 50;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Agencies collection - company info
    match /agencies/{userId} {
      // Allow public read access so anyone can view agency profiles
      allow read: if true;
      allow create: if isOwner(userId) &&
                      request.resource.data.keys().hasAll(['email', 'userType']) &&
                      validateEmail(request.resource.data.email) &&
                      request.resource.data.userType == 'agency' &&
                      (!request.resource.data.keys().hasAny(['verified']) || request.resource.data.verified == false);
      allow update: if isOwner(userId) &&
                      // Prevent agencies from self-verifying
                      (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified']));
      allow delete: if isOwner(userId);
    }

    // Jobs collection - SECURE RULES
    match /jobs/{jobId} {
      // Public read access for browsing jobs
      allow read: if true;

      // Only agencies can create jobs - with proper security
      allow create: if isAgency() &&
                      // Critical security checks
                      request.resource.data.agencyId == request.auth.uid &&
                      // Field validations (adjusted for realistic use)
                      validateStringLength(request.resource.data.title, 5, 200) &&
                      validateStringLength(request.resource.data.description, 10, 10000) &&
                      request.resource.data.skills is list &&
                      request.resource.data.skills.size() <= 50 &&
                      request.resource.data.experienceRequired >= 0 &&
                      request.resource.data.experienceRequired <= 50;

      // Only job owner can update
      allow update: if isAgency() &&
                      resource.data.agencyId == request.auth.uid &&
                      // Cannot change owner
                      request.resource.data.agencyId == resource.data.agencyId;

      // Only job owner can delete
      allow delete: if isAgency() &&
                      resource.data.agencyId == request.auth.uid;
    }

    // Applications collection
    match /applications/{applicationId} {
      // Job hunters can read their own applications
      // Agencies can read applications for their jobs
      allow get: if isAuthenticated() && (
                    resource.data.jobHunterId == request.auth.uid ||
                    resource.data.agencyId == request.auth.uid
                  );

      // Allow list queries - Firestore will filter based on the query constraints
      // This enables queries like where('jobHunterId', '==', userId)
      allow list: if isAuthenticated();

      // Only job hunters can create applications
      allow create: if isJobHunter() &&
                      request.resource.data.keys().hasAll([
                        'jobId', 'jobHunterId', 'agencyId',
                        'status', 'appliedAt'
                      ]) &&
                      request.resource.data.jobHunterId == request.auth.uid &&
                      request.resource.data.status == 'pending' &&
                      request.resource.data.appliedAt is timestamp &&
                      // Validate job exists
                      exists(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)) &&
                      // Validate optional fields
                      (!request.resource.data.keys().hasAny(['coverLetter']) ||
                       request.resource.data.coverLetter == null ||
                       validateStringLength(request.resource.data.coverLetter, 0, 5000)) &&
                      (!request.resource.data.keys().hasAny(['resumeUrl']) ||
                       request.resource.data.resumeUrl == null ||
                       request.resource.data.resumeUrl is string) &&
                      (!request.resource.data.keys().hasAny(['conversationId']) ||
                       request.resource.data.conversationId == null ||
                       request.resource.data.conversationId is string);

      // Job hunters can update their own applications (withdraw, update cover letter)
      // Agencies can update status only
      allow update: if isAuthenticated() && (
                      (resource.data.jobHunterId == request.auth.uid &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'jobId', 'jobHunterId', 'agencyId'])) ||
                      (get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.agencyId == request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                       request.resource.data.status in ['pending', 'reviewing', 'shortlisted', 'rejected', 'accepted'])
                    );

      // Only job hunters can delete their own applications (before review)
      allow delete: if isJobHunter() &&
                      resource.data.jobHunterId == request.auth.uid &&
                      resource.data.status == 'pending';
    }

    // Conversations collection
    match /conversations/{conversationId} {
      // Participants can read their own conversations
      allow read: if isAuthenticated() && (
                    resource.data.jobHunterId == request.auth.uid ||
                    resource.data.agencyId == request.auth.uid
                  );

      // Both parties can create conversations
      allow create: if isAuthenticated() &&
                      request.resource.data.keys().hasAll([
                        'jobId', 'jobHunterId', 'agencyId',
                        'createdAt', 'updatedAt'
                      ]) &&
                      (request.resource.data.jobHunterId == request.auth.uid ||
                       request.resource.data.agencyId == request.auth.uid) &&
                      request.resource.data.createdAt is timestamp &&
                      request.resource.data.updatedAt is timestamp &&
                      // Validate job exists
                      exists(/databases/$(database)/documents/jobs/$(request.resource.data.jobId));

      // Participants can update only specific fields (lastMessage, unreadCount, updatedAt)
      allow update: if isAuthenticated() && (
                      resource.data.jobHunterId == request.auth.uid ||
                      resource.data.agencyId == request.auth.uid
                    ) &&
                    request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['lastMessage', 'unreadCount', 'updatedAt']) &&
                    !request.resource.data.diff(resource.data).affectedKeys()
                      .hasAny(['jobId', 'jobHunterId', 'agencyId', 'createdAt']);

      // No deletion of conversations
      allow delete: if false;

      // Messages subcollection
      match /messages/{messageId} {
        // Participants can read messages
        allow read: if isAuthenticated() && (
                      get(/databases/$(database)/documents/conversations/$(conversationId)).data.jobHunterId == request.auth.uid ||
                      get(/databases/$(database)/documents/conversations/$(conversationId)).data.agencyId == request.auth.uid
                    );

        // Participants can create messages with rate limiting
        allow create: if isAuthenticated() &&
                        request.resource.data.keys().hasAll([
                          'senderId', 'senderType', 'conversationId', 'content', 'timestamp', 'read'
                        ]) &&
                        request.resource.data.senderId == request.auth.uid &&
                        request.resource.data.conversationId == conversationId &&
                        request.resource.data.senderType in ['jobhunter', 'agency'] &&
                        validateStringLength(request.resource.data.content, 1, 2000) &&
                        request.resource.data.timestamp is timestamp &&
                        request.resource.data.read is bool &&
                        (get(/databases/$(database)/documents/conversations/$(conversationId)).data.jobHunterId == request.auth.uid ||
                         get(/databases/$(database)/documents/conversations/$(conversationId)).data.agencyId == request.auth.uid);

        // Only sender can update their messages (mark as edited) or receiver can mark as read
        allow update: if isAuthenticated() && (
                        (resource.data.senderId == request.auth.uid &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'edited', 'editedAt'])) ||
                        (resource.data.senderId != request.auth.uid &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']))
                      );

        // No deletion of messages
        allow delete: if false;
      }
    }

    // Saved Jobs collection (user-specific)
    match /savedJobs/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);

      match /jobs/{jobId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
                        isJobHunter() &&
                        exists(/databases/$(database)/documents/jobs/$(jobId));
        allow delete: if isOwner(userId);
      }
    }

    // Featured Requests collection
    match /featuredRequests/{requestId} {
      // Admins can read all requests
      // Agencies can read their own requests
      allow read: if isAuthenticated();

      // Only verified agencies can create featured requests
      allow create: if isVerifiedAgency() &&
                      request.resource.data.keys().hasAll([
                        'jobId', 'agencyId', 'status',
                        'paymentMethod', 'paymentReference',
                        'paymentAmount', 'currency', 'createdAt', 'updatedAt'
                      ]) &&
                      request.resource.data.agencyId == request.auth.uid &&
                      request.resource.data.status == 'pending' &&
                      request.resource.data.paymentAmount > 0 &&
                      request.resource.data.paymentMethod in ['gcash', 'paymaya', 'bank_transfer', 'paypal'] &&
                      validateStringLength(request.resource.data.paymentReference, 1, 100) &&
                      // Validate job exists and belongs to agency
                      exists(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)) &&
                      get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.agencyId == request.auth.uid;

      // Agencies can update their own pending requests
      // Admins can update any request (approve/reject)
      allow update: if isAuthenticated();

      // No deletion of featured requests
      allow delete: if false;
    }

    // Job Views collection (for analytics)
    match /jobViews/{viewId} {
      // Anyone can read view counts (aggregated)
      allow read: if true;

      // Anyone can create a view (track anonymous and authenticated views)
      allow create: if request.resource.data.keys().hasAll(['jobId', 'viewedAt']) &&
                      request.resource.data.viewedAt is timestamp &&
                      exists(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)) &&
                      // If userId field exists, it must match authenticated user
                      (!request.resource.data.keys().hasAny(['userId']) ||
                       request.resource.data.userId == null ||
                       (isAuthenticated() && request.resource.data.userId == request.auth.uid));

      // No updates or deletes
      allow update, delete: if false;
    }

    // Agency Stats collection (cached aggregations)
    match /agencyStats/{agencyId} {
      // Anyone can read stats
      allow read: if true;

      // Only the agency or system can write
      allow write: if isOwner(agencyId) || isAgency();
    }

    // Agency Reviews collection (future)
    match /agencyReviews/{reviewId} {
      // Anyone can read reviews
      allow read: if true;

      // Only job hunters who were hired can create reviews
      allow create: if isJobHunter() &&
                      request.resource.data.keys().hasAll(['agencyId', 'jobHunterId', 'rating', 'createdAt']) &&
                      request.resource.data.jobHunterId == request.auth.uid &&
                      request.resource.data.rating >= 1 &&
                      request.resource.data.rating <= 5 &&
                      request.resource.data.createdAt is timestamp;

      // Only owner can update their review
      allow update: if isAuthenticated() &&
                      resource.data.jobHunterId == request.auth.uid;

      // No deletes
      allow delete: if false;
    }

    // Notifications collection
    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if isAuthenticated() &&
                     resource.data.userId == request.auth.uid;

      // System/backend creates notifications via Cloud Functions
      // Users cannot create their own notifications
      allow create: if false;

      // Users can update their own notifications (mark as read)
      allow update: if isAuthenticated() &&
                      resource.data.userId == request.auth.uid &&
                      request.resource.data.userId == resource.data.userId &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'updatedAt']);

      // Users can delete their own notifications
      allow delete: if isAuthenticated() &&
                      resource.data.userId == request.auth.uid;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
